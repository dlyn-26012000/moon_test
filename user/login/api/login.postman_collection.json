{
  "info": {
    "name": "User Login API - moon.dlyn.site",
    "_postman_id": "b1e6f0a0-1111-4d2e-9a3b-loginqa2026",
    "description": "E2E API tests for POST user/auth/login. Endpoint is throttled 5 req/min per IP — run groups slowly or expect 429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api-moon.dlyn.site/api" },
    { "key": "username", "value": "user001" },
    { "key": "password", "value": "password" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Login success",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.code === 200 || pm.response.code === 429);",
        "if (pm.response.code === 200) {",
        "  const j = pm.response.json();",
        "  pm.test('status SUCCESS', () => pm.expect(j.status).to.eql('SUCCESS'));",
        "  pm.test('message LOGIN_SUCCESS', () => pm.expect(j.message).to.eql('LOGIN_SUCCESS'));",
        "  pm.test('token shape <id>|<hash>', () => pm.expect(j.data).to.match(/^[0-9]+\\|[A-Za-z0-9]+$/));",
        "  pm.collectionVariables.set('token', j.data);",
        "}"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
        "url": { "raw": "{{baseUrl}}/user/auth/login", "host": ["{{baseUrl}}"], "path": ["user","auth","login"] }
      }
    },
    {
      "name": "02 - Wrong password (BUG: expect 401, gets 500)",
      "event": [{ "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('message CREDENTIALS_INCORRECT', () => pm.expect(j.message).to.be.oneOf(['CREDENTIALS_INCORRECT','Too Many Attempts.']));",
        "pm.test('SHOULD be 401 (documenting BUG-001: is 500)', () => pm.expect(pm.response.code).to.be.oneOf([401,500,429]));"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-wrong\"\n}" },
        "url": { "raw": "{{baseUrl}}/user/auth/login", "host": ["{{baseUrl}}"], "path": ["user","auth","login"] }
      }
    },
    {
      "name": "03 - Unknown user (BUG-002: enumeration)",
      "event": [{ "listen": "test", "script": { "exec": [
        "const j = pm.response.json();",
        "pm.test('message USER_NOT_FOUND (leaks existence)', () => pm.expect(j.message).to.be.oneOf(['USER_NOT_FOUND','Too Many Attempts.']));"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"no_such_user_zzz\",\n  \"password\": \"password\"\n}" },
        "url": { "raw": "{{baseUrl}}/user/auth/login", "host": ["{{baseUrl}}"], "path": ["user","auth","login"] }
      }
    },
    {
      "name": "04 - Missing fields (422)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('422 or 429', () => pm.expect(pm.response.code).to.be.oneOf([422,429]));",
        "if (pm.response.code === 422){ const j = pm.response.json(); pm.test('validation errors present', () => pm.expect(j.errors).to.have.property('username')); }"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{baseUrl}}/user/auth/login", "host": ["{{baseUrl}}"], "path": ["user","auth","login"] }
      }
    },
    {
      "name": "05 - Password type-juggling (422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": [\"password\"]\n}" },
        "url": { "raw": "{{baseUrl}}/user/auth/login", "host": ["{{baseUrl}}"], "path": ["user","auth","login"] }
      }
    },
    {
      "name": "06 - GET me (with token)",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 or 401', () => pm.expect(pm.response.code).to.be.oneOf([200,401]));"
      ], "type": "text/javascript" } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/user/auth/me", "host": ["{{baseUrl}}"], "path": ["user","auth","me"] }
      }
    },
    {
      "name": "07 - Logout (delete current token)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/user/auth/logout", "host": ["{{baseUrl}}"], "path": ["user","auth","logout"] }
      }
    }
  ]
}
